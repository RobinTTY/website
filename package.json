{
  "name": "personal-website",
  "description": "My personal website",
  "license": "MIT",
  "author": "personal-website",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint . && prettier \"**/*.ts\" --check",
    "format": "eslint . --fix && prettier \"**/*.ts\" --write",
    "build": "rimraf dist && tsc && rollup -c rollup.config.js && npm run analyze -- --exclude dist && copyfiles assets/**/* ./dist",
    "start:build": "web-dev-server --root-dir dist --app-index index.html --open",
    "analyze": "cem analyze --litelement",
    "start": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@lit-labs/router": "^0.1.4",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/eslint-config": "^13.1.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@web/dev-server": "^1.0.0",
    "@web/rollup-plugin-html": "^4.0.0",
    "@web/rollup-plugin-import-meta-assets": "^3.0.0",
    "babel-plugin-template-html-minifier": "^4.1.0",
    "concurrently": "^10.0.4",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-workbox": "^9.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "customElements": "custom-elements.json"
}
